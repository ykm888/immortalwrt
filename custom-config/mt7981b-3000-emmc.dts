/dts-v1/;
#include "mt7981.dtsi"

/ {
	/* 物理对齐：严禁修改此兼容性字符串 */
	compatible = "sl,3000-emmc", "mediatek,mt7981";
	model = "SL-3000 eMMC (1024MB Partitioning)";

	chosen {
		bootargs = "console=ttyS0,115200n1 loglevel=8 root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};
};

&mmc0 {
	status = "okay";
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <26000000>;
	no-sd;
	no-sdio;
	non-removable;
	/* 引用原厂导出的 Pinctrl 标识符 */
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* 物理保留：原厂 GPT 引导区 */
		partition@0 {
			label = "gpt";
			reg = <0x0 0x100000>;
			read-only;
		};

		partition@100000 {
			label = "u-boot-env";
			reg = <0x100000 0x80000>;
		};

		/* 物理缝合：128MB Kernel 分区 */
		partition@380000 {
			label = "kernel";
			reg = <0x380000 0x8000000>;
		};

		/* 物理缝合：1024MB Rootfs 分区 */
		partition@8380000 {
			label = "rootfs";
			reg = <0x8380000 0x40000000>;
		};
	};
};

/* 物理保留原厂导出的 Pinctrl 配置，适配 24.10 &pio 节点 */
&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};
	mmc0_pins_uhs: mmc0-pins-uhs {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};
};
