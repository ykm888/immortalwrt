/dts-v1/;
#include "mt7981.dtsi"

/ {
	compatible = "sl,3000-emmc", "mediatek,mt7981";
	model = "SL-3000 eMMC";

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};

	chosen {
		bootargs = "console=ttyS0,115200n1 loglevel=8 root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
	};
};

/* 物理引用：锁定 MSDC0 作为系统存储 */
&mmc0 {
	status = "okay";
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <52000000>;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "gpt";
			reg = <0x0 0x100000>;
			read-only;
		};

		partition@100000 {
			label = "u-boot-env";
			reg = <0x100000 0x80000>;
		};

		partition@180000 {
			label = "factory";
			reg = <0x180000 0x200000>;
			read-only;
		};

		/* 物理锁定：128MB 内核分区 */
		partition@380000 {
			label = "kernel";
			reg = <0x380000 0x8000000>;
		};

		/* 物理锁定：Rootfs */
		partition@8380000 {
			label = "rootfs";
			reg = <0x8380000 0x30000000>;
		};
	};
};
