/dts-v1/;
#include "mt7981.dtsi"

/ {
	compatible = "sl,3000-emmc", "mediatek,mt7981";
	model = "SL-3000 eMMC (23.05 Physical Aligned)";

	chosen {
		# 修复：明确指定 root 挂载点，物理匹配 128MB 后的 rootfs 分区标签
		bootargs = "console=ttyS0,115200n1 loglevel=8 root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x40000000>;
	};
};

&mmc0 {
	status = "okay";
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <26000000>;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "gpt";
			reg = <0x0 0x100000>;
			read-only;
		};

		partition@100000 {
			label = "u-boot-env";
			reg = <0x100000 0x80000>;
		};

		partition@180000 {
			label = "factory";
			reg = <0x180000 0x200000>;
			read-only;
		};

		# 物理锁定点：128MB 内核分区 (0x8000000)
		partition@380000 {
			label = "kernel";
			reg = <0x380000 0x8000000>;
		};

		# 物理衔接点：从 0x8380000 开始的 Rootfs
		partition@8380000 {
			label = "rootfs";
			reg = <0x8380000 0x40000000>;
		};
	};
};

&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux { function = "flash"; groups = "emmc_45"; };
		conf {
			pins = "MSDC0_CLK", "MSDC0_CMD", "MSDC0_DAT0", "MSDC0_DAT1", "MSDC0_DAT2", "MSDC0_DAT3", "MSDC0_DAT4", "MSDC0_DAT5", "MSDC0_DAT6", "MSDC0_DAT7", "MSDC0_DSL";
			drive-strength = <8>;
		};
	};

	mmc0_pins_uhs: mmc0-pins-uhs {
		mux { function = "flash"; groups = "emmc_45"; };
		conf {
			pins = "MSDC0_CLK", "MSDC0_CMD", "MSDC0_DAT0", "MSDC0_DAT1", "MSDC0_DAT2", "MSDC0_DAT3", "MSDC0_DAT4", "MSDC0_DAT5", "MSDC0_DAT6", "MSDC0_DAT7", "MSDC0_DSL";
			drive-strength = <8>;
		};
	};
};
