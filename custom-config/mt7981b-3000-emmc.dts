/dts-v1/;
#include "mt7981.dtsi"

/ {
	/* 物理锁定：必须与原厂导出字符串完全一致 */
	compatible = "sl,3000-emmc", "mediatek,mt7981";
	model = "SL-3000 eMMC (1024MB Partitioning)";

	chosen {
		bootargs = "console=ttyS0,115200n1 loglevel=8 root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
	};
};

&mmc0 {
	status = "okay";
	bus-width = <8>;
	cap-mmc-highspeed;
	max-frequency = <26000000>;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* 物理保留：引导区边界 */
		partition@0 {
			label = "gpt";
			reg = <0x0 0x100000>;
			read-only;
		};

		partition@100000 {
			label = "u-boot-env";
			reg = <0x100000 0x80000>;
		};

		/* 物理修复：扩容 Kernel (128MB) */
		partition@380000 {
			label = "kernel";
			reg = <0x380000 0x8000000>;
		};

		/* 物理修复：扩容 Rootfs (1024MB) */
		partition@8380000 {
			label = "rootfs";
			reg = <0x8380000 0x40000000>;
		};
	};
};

/* 物理保留原厂导出的 LED 逻辑 */
&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};
	mmc0_pins_uhs: mmc0-pins-uhs {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};
};
