# 物理强制开启：U-Boot 与 ATF 救砖核心 (基于您的 6.6 仓库物理对位)
CONFIG_PACKAGE_trusted-firmware-a-mt7981-emmc-ddr3=y
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl_3000-emmc=y

# 物理死锁：机型定义 (完全延续自您的 sl3000.config.txt)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc=y

# 物理屏蔽：禁止 ASR3000 干扰
# CONFIG_TARGET_mediatek_filogic_DEVICE_abt_asr3000 is not set
# CONFIG_PACKAGE_uboot-mediatek-mt7981_abt_asr3000 is not set

# --- 以下物理延续您贴出的 8000 行原文结构 (示例缩略) ---
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_UPGRADE_GUID=y

# [此处物理照抄您原文件中其余 8000 行插件配置]
# 由于执行 make defconfig 时会自动补全插件依赖
# 您只需在 GitHub 仓库中保留原有的插件勾选即可
