# Target System & Device
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_3000-emmc=y

# 物理修正：分区大小 (单位: KB)
# 128MB 内核填充，确保物理偏移对齐，防止红灯
CONFIG_TARGET_KERNEL_PARTSIZE=131072
# 物理修正：由 1048576 (1GB) 降至 131072 (128MB)
# 物理意义：内核(128MB) + 系统(128MB) = 256MB，确保 U-Boot 物理刷入必过
CONFIG_TARGET_ROOTFS_PARTSIZE=131072

# Image Configuration
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# eMMC & Storage Drivers (24.10 Kernel 6.6)
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y

# Storage & Partition Tools
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y

# System Optimization
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# Luci & Core Packages
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# 物理屏蔽：禁用签名以防止编译中断
# CONFIG_SIGNED_PACKAGES is not set
