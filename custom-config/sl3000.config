CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_3000-emmc=y

# 物理死锁：强制 U-Boot 与 FIP 产出
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl-3000-emmc=y
CONFIG_PACKAGE_mtk-bmt-mtd=y
CONFIG_TARGET_IMAGE_uboot-mediatek-mt7981_sl-3000-emmc=y

# 物理偏移：锁定 128MB 边界 (131072 KB)
CONFIG_TARGET_KERNEL_PARTSIZE=131072
CONFIG_TARGET_ROOTFS_PARTSIZE=131072
CONFIG_TARGET_ROOTFS_PARTNAME="rootfs"

# 系统镜像定义
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# eMMC 物理驱动与文件系统
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y

# 物理激活 114GB 剩余空间的工具链
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y

# 内存与系统优化
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# 核心界面与网络工具
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# 物理安全：屏蔽签名
# CONFIG_SIGNED_PACKAGES is not set
