CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl3000-emmc=y

# 物理死锁：强制 U-Boot 与 FIP 产出 (修正包名对齐 24.10)
CONFIG_PACKAGE_uboot-mediatek=y
CONFIG_PACKAGE_atf-mt7981=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_sl3000-emmc=y

# 物理偏移：锁定分区边界
CONFIG_TARGET_KERNEL_PARTSIZE=131072
CONFIG_TARGET_ROOTFS_PARTSIZE=1048576
CONFIG_TARGET_ROOTFS_PARTNAME="rootfs"

# 系统镜像定义
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# eMMC 物理驱动与文件系统
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y

# 物理激活工具链
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y

# 内存与系统优化
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# 核心界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
